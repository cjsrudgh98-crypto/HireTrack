{
  "manifest_version": 3,
  "name": "HireTrack — 공고 저장",
  "short_name": "HireTrack",
  "version": "1.0.0",
  "description": "보고 있는 채용 공고를 버튼 한 번으로 HireTrack 보드에 저장합니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "HireTrack에 공고 저장",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
