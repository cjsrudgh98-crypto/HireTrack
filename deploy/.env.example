# 서버의 /opt/hiretrack/.env 로 복사해서 채운다. 이 파일(.env)은 절대 저장소에 커밋하지 않는다.

# 배포 대상 이미지 (deploy.sh 가 TAG 를 커밋 SHA 로 바꿔 가며 배포)
IMAGE_PREFIX=ghcr.io/<github-user>
TAG=latest

DOMAIN=hiretrack.example.com
LETSENCRYPT_EMAIL=you@example.com

DB_USERNAME=hiretrack
DB_PASSWORD=<openssl rand -base64 24>

# 32바이트 이상: openssl rand -base64 48
JWT_SECRET=<openssl rand -base64 48>

# 확장 프로그램 출처 (manifest 의 key 로 고정된 ID)
CORS_ALLOWED_ORIGINS=chrome-extension://kkdekpdfgncihpjpjbllcmmpodengigh

# 메일 (Gmail: 2단계 인증 후 앱 비밀번호)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_USERNAME=you@gmail.com
SPRING_MAIL_PASSWORD=<앱 비밀번호>
MAIL_FROM=HireTrack <you@gmail.com>

# 에러 추적 (선택)
SENTRY_DSN=

# 백업을 서버 밖으로 보낼 rclone 원격 (선택, 예: r2:hiretrack-backups)
BACKUP_REMOTE=
